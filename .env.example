# Copy to a private file and fill in real values. NEVER commit real values.
# These are passed at build/run time via --dart-define, e.g.:
#   flutter run --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=YOUR_ANON_KEY \
#     --dart-define=GCP_CLOUD_PROJECT_NUMBER=123456789012 \
#     --dart-define=STRICT_INTEGRITY_CHECK=true

# Supabase project
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Google Cloud project number (used to request Play Integrity tokens)
GCP_CLOUD_PROJECT_NUMBER=YOUR_GCP_CLOUD_PROJECT_NUMBER

# true: fail hard when an integrity token cannot be obtained/verified
# false: allow requests without integrity (dev builds only)
STRICT_INTEGRITY_CHECK=true
